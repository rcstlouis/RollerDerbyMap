{
  "name": "derby-phonebook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 8080",
    "serve": "vite --port 8080",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "deploy": "yarn run build-only && firebase deploy --only hosting:rollerderbymap",
    "deploy:preview": "yarn run build-only && firebase hosting:channel:deploy preview --expires 7d --debug"
  },
  "dependencies": {
    "@googlemaps/extended-component-library": "^0.6.14",
    "@googlemaps/js-api-loader": "^1.16.8",
    "@supabase/supabase-js": "^2.50.0",
    "@types/geojson": "^7946.0.16",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "@vueuse/core": "^12.2.0",
    "firebase": "^12.5.0",
    "mapbox-gl": "^3.23.1",
    "node-geocoder": "^4.4.1",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "string-comparison": "^1.3.0",
    "vue": "^3.5.41",
    "vue-router": "^4.4.5",
    "vuetify": "^4.1.9"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@tsconfig/node22": "^22.0.0",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^22.9.3",
    "@types/node-geocoder": "^4.2.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.3",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "npm-run-all2": "^7.0.1",
    "prettier": "^3.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^2.1.10"
  }
}
